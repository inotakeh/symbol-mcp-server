{
  "$comment": "Shared project settings (committed). deny/ask rules apply always; allow rules apply after you accept the workspace trust dialog. Hooks are the deterministic layer; the sandbox is the OS-level backstop. See GUARDRAILS.md.",

  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",

    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.gnupg/**)",
      "Read(//data/target/**)",

      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./.mcp.json)",
      "Edit(./.github/workflows/**)",
      "Edit(./.github/CODEOWNERS)",
      "Edit(./.github/dependabot.yml)",
      "Edit(./SECURITY.md)",
      "Edit(./LICENSE)",
      "Edit(./server.json)",
      "Edit(./.npmrc)",
      "Edit(./package-lock.json)",

      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(sudo *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(docker *)",
      "Bash(symbol-bootstrap *)",
      "Bash(npm publish*)",
      "Bash(npm token*)",
      "Bash(npm login*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh secret *)"
    ],

    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(rm -rf *)",
      "Bash(dangerouslyDisableSandbox:true)"
    ],

    "allow": [
      "Bash(npm ci*)",
      "Bash(npm install)",
      "Bash(npm test*)",
      "Bash(npm run *)",
      "Bash(npx vitest*)",
      "Bash(npx biome*)",
      "Bash(npx tsc*)",
      "Bash(npx tsx *)",
      "Bash(node *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",

      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:blog.modelcontextprotocol.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:symbol.github.io)",
      "WebFetch(domain:docs.symbol.dev)",
      "WebFetch(domain:nodewatch.symbol.tools)",
      "WebFetch(domain:sym-main-01.opening-line.jp)",
      "WebFetch(domain:sym-test-01.opening-line.jp)"
    ]
  },

  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "failIfUnavailable": true,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "sym-main-01.opening-line.jp",
        "sym-test-01.opening-line.jp"
      ],
      "allowLocalBinding": true,
      "allowUnixSockets": [],
      "allowAllUnixSockets": false
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.npmrc",
        "~/.netrc",
        "~/.gnupg",
        "/data/target"
      ],
      "denyWrite": [
        "./.claude",
        "./.github/workflows",
        "./CLAUDE.md",
        "./.npmrc",
        "./LICENSE",
        "./SECURITY.md",
        "./server.json"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.npmrc", "mode": "deny" }
      ],
      "envVars": [
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "NODE_AUTH_TOKEN", "mode": "deny" },
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "CLAUDE_CODE_OAUTH_TOKEN", "mode": "deny" },
        { "name": "AWS_ACCESS_KEY_ID", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" }
      ]
    },
    "enableWeakerNestedSandbox": false
  },

  "enableAllProjectMcpServers": false,

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.py",
            "timeout": 10,
            "statusMessage": "guard-bash: checking command"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-files.py",
            "timeout": 10,
            "statusMessage": "guard-files: checking path"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scan-secrets.py",
            "timeout": 10,
            "statusMessage": "scan-secrets: scanning written file"
          }
        ]
      }
    ]
  }
}
